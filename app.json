{
  "expo": {
    "name": "Wildday",
    "slug": "wildday",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wildday",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyberangeloking.wildday"
    },
    "android": {
      "package": "com.cyberangeloking.wildday"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ]
  }
}
